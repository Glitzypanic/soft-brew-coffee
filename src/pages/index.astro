---
import { Picture } from 'astro:assets';
import Arrow from '../components/Arrow.astro';
import Collection from '../components/Collection.astro';
import KeepCold from '../components/KeepCold.astro';
import Layout from '../layouts/Base.astro';
import heroFlatlay from '../assets/hero-flatlay.jpg';
import pause from '../assets/pause.jpeg';
import coast from '../assets/coast.jpeg';
import { origins } from '../data/origins';

const peru = origins.find((origin) => origin.id === 'peru')!;
const colombia = origins.find((origin) => origin.id === 'colombia')!;

// Hero title, one entry per line. Each word keeps its index for the stagger animation.
const titleWords = [
  ['Café', 'de', 'especialidad'],
  ['en', 'frío.'],
];
let titleIndex = 0;
const titleLines = titleWords.map((line) =>
  line.map((word) => ({ word, index: titleIndex++ })),
);
---

<Layout path="/">
  <section class="spec" aria-labelledby="hero-title">
    <h1 id="hero-title" class="spec-title">
      {
        titleLines.map((line, lineIndex) => (
          <span class:list={['line', lineIndex > 0 && 'line-2']}>
            {line.map(({ word, index }, position) => (
              <>
                {position > 0 && ' '}
                <span class="word" style={`--i:${index}`}>
                  {word}
                </span>
              </>
            ))}
          </span>
        ))
      }
    </h1>
    <KeepCold class="hero-snow" />
    <figure class="spec-photo">
      <Picture
        src={heroFlatlay}
        alt="Dos botellines de cold brew, Perú y Colombia, sobre una mesa de madera con granos de café"
        width={1372}
        widths={[480, 800, 1200, 1372]}
        sizes="(max-width: 700px) 67vw, 58vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        quality={60}
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <div class="spec-data">
      <div class="spec-cell spec-volume">
        <p class="mono">FORMATO</p>
        <p class="spec-figure">
          <strong class="count" data-count="200">200</strong><span>ML</span>
        </p>
        <p class="mono">BOTELLÍN · COLD BREW</p>
      </div>
      <div class="spec-row">
        <div class="spec-cell">
          <p class="mono"><span class="accent-number">01</span> PERÚ</p>
          <p class="spec-figure">
            <strong class="count" data-count="16">16</strong><span>H</span>
          </p>
          <p class="mono">INFUSIÓN</p>
        </div>
        <div class="spec-cell">
          <p class="mono"><span class="accent-number">02</span> COLOMBIA</p>
          <p class="spec-figure">
            <strong class="count" data-count="24">24</strong><span>H</span>
          </p>
          <p class="mono">INFUSIÓN</p>
        </div>
      </div>
      <div class="spec-cell spec-intro">
        <p>Una nueva perspectiva para el café de especialidad.</p>
        <a
          href="#origenes"
          class="spec-link"
          aria-label="Descubrir los dos orígenes"><Arrow direction="down" /></a
        >
      </div>
      <div class="spec-cell spec-brand">
        <img
          src="/brand/soft-brew-coffee.svg"
          alt="Soft Brew Coffee"
          width="601"
          height="429"
        />
        <p class="mono">BUEN CAFÉ. EN FRÍO.</p>
      </div>
    </div>
  </section>

  <Collection />

  <section class="bento-section" id="lado-frio" aria-labelledby="pause-title">
    <div class="bento-heading">
      <p class="mono eyebrow">OTRA PERSPECTIVA</p>
      <h2 id="pause-title">Dos formas de <span>tomarlo.</span></h2>
      <a class="bento-heading-link mono" href="/preparaciones/"
        >VER PREPARACIONES <Arrow /></a
      >
    </div>
    <div class="bento">
      <figure class="bento-tile bento-photo bento-peru-photo" style="--d:0ms">
        <div class="bento-photo-frame">
          <Picture
            src={pause}
            width={1200}
            alt="Botellín de Perú junto a un vaso con hielo y una rodaja de cítrico, sobre una mesa de madera"
            widths={[480, 800, 1200]}
            sizes="(max-width: 700px) 67vw, 58vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            quality={60}
            loading="lazy"
          />
        </div>
      </figure>
      <div class="bento-tile bento-copy bento-peru-copy" style="--d:120ms">
        <span class="moment-num">01</span>
        <h3>Tarde de avellana</h3>
        <p>
          Infusión de {peru.infusionHours} horas. {peru.notes.join(', ')},
          servido con hielo y una rodaja de limón.
        </p>
        <p class="mono bento-meta">{peru.notes.join(' · ')} · 200 ml</p>
      </div>
      <div class="bento-tile bento-copy bento-colombia-copy" style="--d:0ms">
        <span class="moment-num">02</span>
        <h3>Para llevar</h3>
        <p>
          Infusión de {colombia.infusionHours} horas. Para el bolso, la playa o el
          camino.
        </p>
        <p class="mono bento-meta">{colombia.notes.join(' · ')} · 200 ml</p>
      </div>
      <figure
        class="bento-tile bento-photo bento-colombia-photo"
        style="--d:120ms"
      >
        <div class="bento-photo-frame">
          <Picture
            src={coast}
            width={1000}
            alt="Botellín de Colombia en una mano frente al mar"
            widths={[480, 800, 1000]}
            sizes="(max-width: 700px) 67vw, 58vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            quality={60}
            loading="lazy"
          />
        </div>
      </figure>
      <div class="bento-tile bento-data" style="--d:0ms">
        <div>
          <p class="bento-figure">{peru.infusionHours}<span>H</span></p><p
            class="mono"
          >
            PERÚ · INFUSIÓN
          </p>
        </div>
        <div>
          <p class="bento-figure">{colombia.infusionHours}<span>H</span></p><p
            class="mono"
          >
            COLOMBIA · INFUSIÓN
          </p>
        </div>
      </div>
      <a class="bento-tile bento-cta" href="/#origenes" style="--d:120ms">
        <span class="mono">ELEGIR ORIGEN</span>
        <span class="bento-cta-word">Pedir</span>
        <Arrow />
      </a>
    </div>
  </section>
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Count-up for the spec numbers, starting when they scroll into view.
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const runCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    if (reduceMotion.matches) return;
    const duration = 1100;
    const start = performance.now();
    el.textContent = '0';
    const step = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = String(Math.round(target * eased));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (!reduceMotion.matches) {
    counters.forEach((el) => {
      el.textContent = '0';
    });
    const counterObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          runCount(entry.target as HTMLElement);
          counterObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.5 },
    );
    counters.forEach((el) => counterObserver.observe(el));
  }

  // Start the title reveal after the first paint, so the transition runs.
  window.setTimeout(
    () => document.documentElement.classList.add('is-ready'),
    120,
  );
</script>
