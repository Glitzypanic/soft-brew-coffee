---
interface Props {
  direction?: 'down' | 'diagonal';
  class?: string;
}
const { direction = 'diagonal', class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 48 48"
  fill="none"
  aria-hidden="true"
  style={direction === 'down' ? 'transform:rotate(135deg)' : undefined}
>
  <path d="M10 38 38 10M10 10h28v28" stroke="currentColor" stroke-width="3"
  ></path>
</svg>
