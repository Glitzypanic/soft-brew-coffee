---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  origin: string;
  name: string;
  eager?: boolean;
  context?: 'collection' | 'hero';
  class?: string;
}
const {
  origin,
  name,
  eager = false,
  context = 'collection',
  class: className,
} = Astro.props;
const lighting: Record<string, string> = {
  colombia: context === 'hero' ? 'colombia-yellow' : 'colombia-grey',
  peru: 'peru-yellow',
  honduras: 'honduras-vibrant-pink',
  'costa-rica': 'costa-rica-royal-blue',
};
const assets = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/relit-*.png',
  { eager: true },
);
const bottle = assets[`../assets/relit-${lighting[origin]}.png`]?.default;
if (!bottle) throw new Error(`Missing bottle asset for ${origin}`);
---

<span class:list={['bottle', className]}>
  <Image
    src={bottle}
    width={720}
    alt={`Soft Brew Coffee de ${name}, botellín de 200 ml`}
    style="clip-path:url(#bottle-mask)"
    widths={[320, 480, 720]}
    sizes={context === 'hero'
      ? '(max-width: 500px) 60vw, (max-width: 700px) 300px, (min-width: 1800px) 558px, 31vw'
      : '(max-width: 700px) 233px, (max-width: 1050px) 226px, (min-width: 1600px) 306px, 260px'}
    format="webp"
    quality={90}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  <slot />
</span>
