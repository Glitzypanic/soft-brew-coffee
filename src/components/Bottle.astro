---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import colombiaBottle from '../assets/relit-colombia-grey.png';
import peruBottle from '../assets/relit-peru-yellow.png';

interface Props {
  origin: string;
  name: string;
}

const { origin, name } = Astro.props;
const bottles: Record<string, ImageMetadata> = {
  colombia: colombiaBottle,
  peru: peruBottle,
};
const bottle = bottles[origin];
if (!bottle) throw new Error(`Missing bottle asset for ${origin}`);
---

<span class="bottle">
  <Image
    src={bottle}
    width={720}
    alt={`Soft Brew Coffee de ${name}, botellín de 200 ml`}
    style="clip-path:url(#bottle-mask)"
    widths={[320, 480, 720]}
    sizes="(max-width: 380px) 104px, (max-width: 560px) min(32vw, 140px), (max-width: 900px) 153px, (max-width: 1050px) 226px, (min-width: 1600px) 306px, 220px"
    format="webp"
    quality={90}
    loading="lazy"
    decoding="async"
  />
</span>
