---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import colombiaBottle from '../assets/relit-colombia-grey.png';
import peruBottle from '../assets/relit-peru-yellow.png';

interface Props {
  origin: string;
  name: string;
}

const { origin, name } = Astro.props;
const bottles: Record<string, ImageMetadata> = {
  colombia: colombiaBottle,
  peru: peruBottle,
};
const bottle = bottles[origin];
if (!bottle) throw new Error(`Missing bottle asset for ${origin}`);
// The bottle is drawn at min(100%, 300px) on desktop and min(60%, 240px) on phones.
---

<span class="bottle">
  <Picture
    src={bottle}
    width={720}
    alt={`Soft Brew Coffee de ${name}, botellín de 200 ml`}
    style="clip-path:url(#bottle-mask)"
    widths={[320, 480, 720]}
    sizes="(max-width: 700px) min(60vw, 240px), 300px"
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    quality={70}
    loading="lazy"
    decoding="async"
  />
</span>
