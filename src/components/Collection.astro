---
import Bottle from './Bottle.astro';
import Arrow from './Arrow.astro';
import { origins, formatCLP, whatsappOrderUrl } from '../data/origins';

const items = origins.filter((origin) => !origin.comingSoon);
const meses = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
const hoy = new Date();
const fechaEnvasado = `${String(hoy.getDate()).padStart(2, '0')} ${meses[hoy.getMonth()]} ${hoy.getFullYear()}`;
const scale = [1, 2, 3, 4, 5];
const profileRows = [
  { key: 'acidez', label: 'ACIDEZ' },
  { key: 'cuerpo', label: 'CUERPO' },
  { key: 'dulzor', label: 'DULZOR' },
] as const;
---
<section class="collection-picker" id="origenes" aria-labelledby="origins-title">
  <div class="picker-heading">
    <p class="mono eyebrow">LA COLECCIÓN / <span class="accent-number">01—02</span></p>
    <h2 id="origins-title">Dos orígenes.</h2>
    <p>Elige un botellín y revisa su sabor, su precio y cómo se pide.</p>
  </div>

  {items.map((origin, index) => (
    <div class="origin-item">
    <button
      type="button"
      class="origin-tab"
      id={`tab-${origin.id}`}
      aria-controls={`panel-${origin.id}`}
      aria-expanded="false"
      data-origin={origin.id}
    >
      <span class="origin-tab-num">{origin.number}</span>
      <span class="origin-tab-name">{origin.name}</span>
      <span class="origin-tab-meta mono">
        <span class="origin-tab-price">{formatCLP(origin.priceCLP)}</span>
        <span class="origin-tab-icon" aria-hidden="true"></span>
      </span>
    </button>
    <article
      class="origin-detail"
      id={`panel-${origin.id}`}
      role="tabpanel"
      aria-labelledby={`tab-${origin.id}`}
      data-origin={origin.id}
      hidden
      style={`--origin-color:${origin.color};--origin-ink:${origin.ink}`}
    >
      <figure class="detail-bottle">
        <Bottle origin={origin.id} name={origin.name} />
      </figure>

      <div class="detail-body">
        <p class="mono detail-kicker">{origin.name} / {origin.number}</p>
        <h3>{origin.name}.</h3>

        <div class="detail-tabs" role="tablist" aria-label={`Detalle de ${origin.name}`}>
          <button type="button" role="tab" class="detail-tab" aria-selected="true" aria-controls={`sabor-${origin.id}`} id={`tab-sabor-${origin.id}`} data-target="sabor">SABOR</button>
          <button type="button" role="tab" class="detail-tab" aria-selected="false" aria-controls={`compra-${origin.id}`} id={`tab-compra-${origin.id}`} data-target="compra">COMPRA</button>
        </div>

        <div class="detail-sabor" id={`sabor-${origin.id}`} role="tabpanel" aria-labelledby={`tab-sabor-${origin.id}`}>
          <p class="mono detail-label">NOTAS</p>
          <ul class="detail-notes">
            {origin.notes.map((note) => <li>{note}</li>)}
          </ul>

          <div class="detail-profile">
            {profileRows.map((row) => (
              <div class="meter">
                <span class="mono meter-label">{row.label}</span>
                <span class="meter-track" role="img" aria-label={`${row.label.toLowerCase()} ${origin.profile[row.key]} de 5`}>
                  {scale.map((step) => <i class:list={[step <= origin.profile[row.key] && 'on']} />)}
                </span>
              </div>
            ))}
          </div>

          <dl class="detail-facts mono">
            <div><dt>INFUSIÓN</dt><dd>{origin.infusionHours} h</dd></div>
            <div><dt>FORMATO</dt><dd>200 ml</dd></div>
            <div><dt>VARIETAL</dt><dd>Arábica</dd></div>
          </dl>
        </div>

        <div class="detail-compra" id={`compra-${origin.id}`} role="tabpanel" aria-labelledby={`tab-compra-${origin.id}`} hidden>
          <p class="detail-price"><span class="mono">PRECIO</span><strong>{formatCLP(origin.priceCLP)}</strong></p>
          <dl class="detail-facts mono">
            <div><dt>FORMATO</dt><dd>200 ml</dd></div>
            <div><dt>ENVASADO</dt><dd>{fechaEnvasado}</dd></div>
            <div><dt>CONSERVACIÓN</dt><dd>Refrigerado</dd></div>
          </dl>
          <a class="detail-cta mono" href={whatsappOrderUrl(origin)} target="_blank" rel="noopener noreferrer">
            <span>PEDIR POR WHATSAPP</span> <Arrow />
          </a>
        </div>
      </div>
    </article>
    </div>
  ))}

  <div class="buy-bar" aria-hidden="true">
    <span class="mono buy-bar-name">{items[0].name}</span>
    <strong class="buy-bar-price">{formatCLP(items[0].priceCLP)}</strong>
    <a class="buy-bar-cta mono" href={whatsappOrderUrl(items[0])} target="_blank" rel="noopener noreferrer" tabindex="-1">PEDIR <Arrow /></a>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('#origenes');
  const tabs = document.querySelectorAll<HTMLButtonElement>('.origin-tab');
  const details = document.querySelectorAll<HTMLElement>('.origin-detail');
  const buyBar = document.querySelector<HTMLElement>('.buy-bar');
  const buyName = buyBar?.querySelector<HTMLElement>('.buy-bar-name');
  const buyPrice = buyBar?.querySelector<HTMLElement>('.buy-bar-price');
  const buyCta = buyBar?.querySelector<HTMLAnchorElement>('.buy-bar-cta');

  function selectOrigin(id: string) {
    const tab = [...tabs].find((t) => t.dataset.origin === id);
    if (!tab) return;
    tabs.forEach((t) => t.setAttribute('aria-expanded', String(t === tab)));
    details.forEach((panel) => {
      panel.hidden = panel.dataset.origin !== id;
    });
    const active = document.querySelector<HTMLElement>(`#panel-${id}`);
    if (!active || !buyBar) return;
    if (buyName) buyName.textContent = tab.querySelector('.origin-tab-name')?.textContent ?? '';
    if (buyPrice) buyPrice.textContent = tab.querySelector('.origin-tab-price')?.textContent ?? '';
    if (buyCta) buyCta.href = active.querySelector<HTMLAnchorElement>('.detail-cta')?.href ?? '#';
  }

  // Clicking the open origin closes it; clicking any other origin opens that one.
  function closeAll() {
    tabs.forEach((t) => t.setAttribute('aria-expanded', 'false'));
    details.forEach((panel) => {
      panel.hidden = true;
    });
  }
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      if (tab.getAttribute('aria-expanded') === 'true') closeAll();
      else selectOrigin(tab.dataset.origin!);
    });
  });

  details.forEach((panel) => {
    const buttons = panel.querySelectorAll<HTMLButtonElement>('.detail-tab');
    const sabor = panel.querySelector<HTMLElement>('.detail-sabor');
    const compra = panel.querySelector<HTMLElement>('.detail-compra');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-selected', String(b === button)));
        if (sabor) sabor.hidden = button.dataset.target !== 'sabor';
        if (compra) compra.hidden = button.dataset.target !== 'compra';
      });
    });
  });

  // Deep links such as #peru open that origin directly.
  const fromHash = location.hash.slice(1);
  if (fromHash) selectOrigin(fromHash);
  window.addEventListener('hashchange', () => selectOrigin(location.hash.slice(1)));

  // Mobile buy bar only while the collection is on screen.
  if (section && buyBar) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        buyBar.classList.toggle('is-visible', entry.isIntersecting);
        buyBar.setAttribute('aria-hidden', String(!entry.isIntersecting));
        if (buyCta) buyCta.tabIndex = entry.isIntersecting ? 0 : -1;
      },
      { threshold: 0.15 },
    );
    observer.observe(section);
  }
</script>

<style>
  .collection-picker {
    overflow-wrap: anywhere;
    background: var(--ink);
    color: var(--grey);
    border-bottom: 2px solid var(--ink);
  }
  .picker-heading {
    padding: 2.5rem var(--gutter);
  }
  .picker-heading h2 {
    overflow-wrap: anywhere;
    font-size: clamp(2.5rem, 5vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    margin: 0.65rem 0;
  }
  .picker-heading > p:last-child {
    font-size: 1.125rem;
    line-height: 1.5;
  }

  /* Origin selector: two hard blocks, the active one fills with its color. */
  .origin-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 2px solid var(--grey);
    border-bottom: 2px solid var(--grey);
  }
  /* Editorial index: one full-width row per origin, its panel opens right below. */
  .origin-item {
    border-top: 2px solid var(--grey);
  }
  .origin-item:last-child {
    border-bottom: 2px solid var(--grey);
  }
  .origin-item .origin-detail {
    border-bottom: 0;
  }
  /* Subtle entrance each time a panel opens. */
  .origin-detail:not([hidden]) {
    animation: detail-in 0.35s ease-out both;
  }
  @keyframes detail-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .origin-tab {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 1.5rem var(--gutter) 1.5rem calc(var(--gutter) + 1.25rem);
    background: transparent;
    color: var(--grey);
    border: 0;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .origin-tab-num {
    font-family: var(--sans);
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .origin-tab-name {
    font-size: clamp(2.5rem, 6vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.95;
    overflow-wrap: anywhere;
  }
  .origin-tab-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }
  .origin-tab-price {
    opacity: 0.75;
  }
  .origin-tab-icon::before {
    content: '+';
    font-family: var(--mono);
    font-size: 1.5rem;
    line-height: 1;
  }
  .origin-tab[aria-expanded='true'] .origin-tab-icon::before {
    content: '−';
  }
  .origin-tab:hover {
    background: #2a2c2b;
  }
  .origin-tab[aria-expanded='true'] {
    background: var(--grey);
    color: var(--ink);
  }
  .origin-tab[aria-expanded='true'] .origin-tab-price {
    opacity: 1;
  }
  .origin-tab:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -6px;
  }

  /* Detail panel: colored block, bottle on the left, facts on the right. */
  .origin-detail {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    background: var(--origin-color);
    color: var(--origin-ink);
    border-bottom: 2px solid var(--grey);
  }
  .origin-detail[hidden] {
    display: none;
  }
  .detail-bottle {
    margin: 0;
    display: grid;
    place-items: center;
    padding: 2.5rem var(--gutter);
    border-right: 2px solid var(--origin-ink);
  }
  .detail-bottle :global(.bottle) {
    display: block;
    width: min(100%, 300px);
    aspect-ratio: 2 / 3;
    height: auto;
  }
  .detail-bottle :global(.bottle img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .detail-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 2.5rem var(--gutter);
    min-width: 0;
  }
  .detail-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .detail-body h3 {
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }
  .detail-tabs {
    display: flex;
    border: 2px solid var(--origin-ink);
    width: fit-content;
  }
  .detail-tab {
    padding: 0.6rem 1.1rem;
    background: transparent;
    color: inherit;
    border: 0;
    font: inherit;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .detail-tab + .detail-tab {
    border-left: 2px solid var(--origin-ink);
  }
  .detail-tab[aria-selected='true'] {
    background: var(--origin-ink);
    color: var(--origin-color);
  }
  .detail-tab:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }
  .detail-label {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .detail-notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    font-family: var(--sans);
    font-size: clamp(1.4rem, 2.6vw, 2.4rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .detail-profile {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .meter {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }
  .meter-label {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .meter-track {
    display: flex;
    flex-wrap: nowrap;
    justify-self: start;
    gap: 4px;
    min-width: 0;
  }
  .meter-track i {
    display: block;
    width: 18px;
    height: 18px;
    border: 2px solid currentColor;
  }
  .meter-track i.on {
    background: currentColor;
  }
  .detail-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin: 0;
    padding-top: 1rem;
    border-top: 2px solid currentColor;
  }
  .detail-facts dt {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }
  .detail-facts dd {
    margin: 0.3rem 0 0;
    font-size: 1rem;
  }
  .detail-sabor {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .detail-compra {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .detail-compra[hidden],
  .detail-sabor[hidden] {
    display: none;
  }
  .detail-price {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .detail-price .mono {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
  .detail-price strong {
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }
  .detail-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    align-self: flex-start;
    padding: 1rem 1.25rem;
    border: 2px solid var(--origin-ink);
    color: inherit;
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    box-shadow: 6px 6px 0 var(--origin-ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .detail-cta:hover,
  .detail-cta:focus-visible {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--origin-ink);
  }
  .detail-cta:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 4px;
  }
  .detail-cta :global(svg) {
    width: 1.1em;
    height: 1.1em;
    flex: none;
  }

  /* Mobile buy bar: hidden until the collection is on screen. */
  .buy-bar {
    display: none;
  }
  @media (max-width: 900px) {
    .origin-detail {
      grid-template-columns: minmax(0, 1fr);
    }
    .detail-bottle {
      border-right: 0;
      border-bottom: 2px solid var(--origin-ink);
      padding: 2rem var(--gutter);
    }
    .detail-bottle :global(.bottle) {
      width: min(60%, 240px);
    }
  }
  @media (max-width: 700px) {
    .origin-tab {
      grid-template-columns: 2.75rem minmax(0, 1fr) auto;
      gap: 0.6rem;
      padding: 1.25rem 1rem 1.25rem 1.1rem;
    }
    .origin-tab-num {
      font-size: 1.1rem;
    }
    .origin-tab-name {
      font-size: clamp(1.75rem, 9vw, 2.6rem);
      min-width: 0;
    }
    .origin-tab-meta {
      gap: 0.6rem;
      font-size: 0.65rem;
    }
    .detail-body {
      padding: 2rem 1.25rem;
    }
    .buy-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 45;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1rem;
      background: var(--ink);
      color: var(--grey);
      border-top: 2px solid var(--grey);
      transform: translateY(110%);
      transition: transform 0.3s ease;
    }
    .buy-bar.is-visible {
      transform: translateY(0);
    }
    .buy-bar-name {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
    }
    .buy-bar-price {
      margin-left: auto;
      font-size: 1.25rem;
      font-weight: 600;
    }
    .buy-bar-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.7rem 0.9rem;
      background: var(--accent);
      color: var(--ink);
      text-decoration: none;
      font-size: 0.75rem;
    }
    .buy-bar-cta :global(svg) {
      width: 1em;
      height: 1em;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .buy-bar,
    .detail-cta {
      transition: none;
    }
    .origin-detail:not([hidden]) {
      animation: none;
    }
  }
</style>
