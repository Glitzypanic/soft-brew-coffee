---
import BuyBar from './collection/BuyBar.astro';
import OriginItem from './collection/OriginItem.astro';
import { origins } from '../data/origins';

const items = origins.filter((origin) => !origin.comingSoon);
---

<section
  class="collection-picker"
  id="origenes"
  aria-labelledby="origins-title"
>
  <div class="picker-heading">
    <p class="mono eyebrow">
      LA COLECCIÓN / <span class="accent-number">01—02</span>
    </p>
    <h2 id="origins-title">Dos orígenes.</h2>
    <p>Elige un botellín y revisa su sabor, su precio y cómo se pide.</p>
  </div>

  {items.map((origin) => <OriginItem origin={origin} />)}

  <BuyBar origin={items[0]} />
</section>

<script>
  import '../scripts/collection';
</script>

<style>
  .collection-picker {
    overflow-wrap: anywhere;
    background: var(--ink);
    color: var(--grey);
    border-bottom: var(--rule);
  }
  .picker-heading {
    padding: var(--space-8) var(--gutter);
  }
  .picker-heading h2 {
    overflow-wrap: anywhere;
    font-size: clamp(2.5rem, 5vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    margin: 0.65rem 0;
  }
  .picker-heading > p:last-child {
    font-size: var(--text-lg);
    line-height: 1.5;
  }
</style>
