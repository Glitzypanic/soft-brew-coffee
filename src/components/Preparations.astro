---
// The four glasses side by side are the selector: the chosen one rises onto a disc in its
// colour and its recipe shows in a band below, one recipe at a time.
import {
  preparations,
  pairingLabel,
  shortName,
  prepVars,
} from '../data/preparations';
import PrepRecipe from './PrepRecipe.astro';

const nn = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="preps" id="preparaciones" aria-labelledby="preps-title">
  <div class="preps-heading">
    <p class="mono eyebrow">
      PREPARACIONES / <span class="accent-number">01—04</span>
    </p>
    <h1 id="preps-title">Cómo tomarlo.</h1>
    <p>Un botellín como base. Cuatro formas de servirlo, sin herramientas.</p>
  </div>

  <div class="glasses" role="group" aria-label="Elige una preparación">
    {
      preparations.map((prep, i) => (
        <button
          type="button"
          class="glass"
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-controls={`recipe-${prep.id}`}
          style={prepVars(prep)}
        >
          <span class="glass-disc">
            <img
              src={prep.art.src}
              width={prep.art.width}
              height={prep.art.height}
              alt=""
              decoding="async"
            />
          </span>
          <span class="glass-label">
            <span class="mono">{nn(i)}</span>
            {shortName(prep.name)}
          </span>
        </button>
      ))
    }
  </div>

  {
    preparations.map((prep, i) => (
      <div
        class="band"
        id={`recipe-${prep.id}`}
        hidden={i !== 0}
        style={prepVars(prep)}
      >
        <div class="band-head">
          <p class="mono">
            {nn(i)} / {pairingLabel[prep.pairsWith]}
          </p>
          <h2>{prep.name}</h2>
        </div>
        <div>
          <PrepRecipe prep={prep} />
        </div>
      </div>
    ))
  }
</section>

<script>
  const glasses = [...document.querySelectorAll<HTMLButtonElement>('.glass')];
  for (const glass of glasses) {
    glass.addEventListener('click', () => {
      for (const g of glasses) {
        const on = g === glass;
        g.setAttribute('aria-pressed', String(on));
        document.getElementById(g.getAttribute('aria-controls')!)!.hidden = !on;
      }
    });
  }
</script>

<style>
  .preps {
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    padding: var(--space-8) var(--gutter);
  }
  .preps-heading {
    margin-bottom: var(--space-8);
  }
  .preps-heading h1 {
    margin: 0.65rem 0;
    overflow-wrap: anywhere;
    font-size: clamp(2.5rem, 5vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.055em;
  }
  .preps-heading > p:last-child {
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .glasses {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .glass {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  .glass-disc {
    display: grid;
    place-items: center;
    width: min(100%, 13rem);
    aspect-ratio: 1;
    border: 1.5px dashed var(--ink);
    border-radius: 50%;
    transition:
      background 0.25s ease,
      translate 0.35s var(--ease-spring);
  }
  .glass-disc img {
    width: 62%;
    height: auto;
    transition: transform 0.35s var(--ease-spring);
  }
  .glass:hover .glass-disc {
    background: color-mix(in srgb, var(--bg) 50%, transparent);
  }
  .glass[aria-pressed='true'] .glass-disc {
    border-style: solid;
    background: var(--bg);
    translate: 0 -0.5rem;
  }
  .glass[aria-pressed='true'] .glass-disc img {
    filter: var(--art-edge);
    transform: rotate(-6deg) scale(1.08);
  }
  .glass:focus-visible {
    outline: none;
  }
  .glass:focus-visible .glass-disc {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  .glass-label {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    /* Scales with the screen so "Affogato" fits under its glass on narrow phones. */
    font-size: clamp(0.75rem, 3.5vw, 1.4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .glass-label .mono {
    font-size: var(--text-sm);
  }
  .glass[aria-pressed='true'] .glass-label {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* The band takes the drink's colours; --ink follows so the recipe's rules match its text. */
  .band {
    --ink: var(--fg);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-8);
    padding: var(--space-8);
    border-radius: var(--space-6);
    background: var(--bg);
    color: var(--fg);
    animation: band-in 0.4s ease;
  }
  .band[hidden] {
    display: none;
  }
  .band-head p {
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
  }
  .band-head h2 {
    margin: var(--space-3) 0 0;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }
  @keyframes band-in {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .band {
      animation: none;
    }
    .glass-disc,
    .glass-disc img {
      transition: none;
    }
  }
  @media (max-width: 760px) {
    .glasses {
      gap: var(--space-2);
    }
    .glass-label {
      flex-direction: column;
      align-items: center;
      gap: 0;
    }
    .band {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
      padding: var(--space-6) var(--space-5);
    }
  }
</style>
